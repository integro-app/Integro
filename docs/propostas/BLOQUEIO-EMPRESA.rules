// Proposta local: ainda não integrada às Rules do produto.
function fimTesteIso(fim) {
  let partes = fim.split("T");
  let dia = partes[0].split("-");
  let hora = partes[1].split(":");
  return timestamp.date(int(dia[0]), int(dia[1]), int(dia[2])) + duration.time(int(hora[0]), int(hora[1]), int(hora[2].split("[.]")[0]), 0);
}
function fimTesteValido(empresa) {
  let fim = empresa.get("dataFimTeste", "");
  return empresa.get("testeAtivo", false) != true || fim == "" ||
    (fim is timestamp ? request.time < fim :
      (fim is string && fim.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}[.][0-9]{3}Z') && request.time < fimTesteIso(fim)));
}
function assinaturaPermitida(empresa) {
  let limite = empresa.get("bloqueioAssinaturaEm", null);
  return limite == null || (limite is timestamp ? request.time < limite : (limite is string && request.time < fimTesteIso(limite)));
}
function empresaDadosPermitidos(empresa) {
  return empresa.get("acessoLiberado", true) != false && empresa.get("ativo", true) != false &&
    !(empresa.get("status", empresa.get("situacao", "")).upper() in ["BLOQUEADO", "INATIVO", "SUSPENSO"]) && fimTesteValido(empresa) && assinaturaPermitida(empresa);
}
function empresaPermitida(user) {
  let tenant = user.get("clientePlataformaId", "");
  let companyPath = /databases/$(database)/documents/clientes_integro/$(tenant);
  return user.get("tipoUsuario", "") in ["master_global", "usuario_integro"] || tenant == "" ||
    (user.get("empresaBloqueada", false) != true && user.get("acessoEmpresaLiberado", true) != false &&
      !(user.get("clientePlataformaStatus", user.get("empresaStatus", "")) in ["BLOQUEADO", "INATIVO", "SUSPENSO"]) &&
      (!exists(companyPath) || empresaDadosPermitidos(get(companyPath).data)));
}
