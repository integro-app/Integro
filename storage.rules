rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid));
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }

    function empresaLiberadaNoStorage(caminho) {
      let empresa = firestore.exists(caminho) ? firestore.get(caminho).data : {};
      return empresa.get("acessoLiberado", true) != false &&
        empresa.get("ativo", true) != false &&
        !(empresa.get("status", "") in ["BLOQUEADO", "INATIVO", "SUSPENSO"]) &&
        (empresa.get("testeAtivo", false) != true ||
          !("dataFimTesteEm" in empresa) || empresa.dataFimTesteEm > request.time) &&
        (!("bloqueioAssinaturaEm" in empresa) ||
          !(empresa.bloqueioAssinaturaEm is timestamp) || empresa.bloqueioAssinaturaEm > request.time);
    }

    function tenantLiberadoNoStorage() {
      return isMasterGlobal() || userDoc().get("tipoUsuario", "") == "usuario_integro" ||
        (userTenantId() is string && userTenantId().size() > 0 &&
          empresaLiberadaNoStorage(/databases/(default)/documents/clientes_integro/$(userTenantId())) &&
          empresaLiberadaNoStorage(/databases/(default)/documents/clientes_plataforma/$(userTenantId())));
    }

    function isActiveUser() {
      return hasUserDoc() &&
        userDoc().get("authUid", "") == request.auth.uid &&
        userDoc().get("acessoLiberado", false) == true &&
        !(userDoc().get("status", "") in ["BLOQUEADO", "INATIVO", "SUSPENSO"]) &&
        tenantLiberadoNoStorage();
    }

    function userTenantId() {
      return userDoc().get("clientePlataformaId", "");
    }

    function isMasterGlobal() {
      return hasUserDoc() && userDoc().get("tipoUsuario", "") == "master_global";
    }

    function isMasterLocal() {
      return hasUserDoc() && userDoc().get("tipoUsuario", "") == "master_local";
    }

    function isFinanceiro() {
      return hasUserDoc() && (userDoc().get("tipoUsuario", "") == "financeiro" ||
        userDoc().get("cargoChave", "") == "financeiro");
    }

    function isAuditor() {
      return hasUserDoc() && (userDoc().get("tipoUsuario", "") == "auditor" || userDoc().get("cargoChave", "") == "auditor");
    }

    function isSameTenant(tenantId) {
      return isActiveUser() &&
        userTenantId() is string &&
        userTenantId().size() > 0 &&
        userTenantId() == tenantId;
    }

    function controlFinanceMap() {
      return userDoc().get("permissoes", {}).get("controleFinanceiro", {});
    }

    function canReadEnterpriseFinance(tenantId) {
      return isSameTenant(tenantId) && (
        isMasterLocal() || isFinanceiro() ||
        controlFinanceMap().get("ver", false) == true
      );
    }

    function canWriteEnterpriseFinance(tenantId) {
      return isSameTenant(tenantId) && (
        isMasterLocal() || isFinanceiro() ||
        controlFinanceMap().get("editar", false) == true ||
        controlFinanceMap().get("baixar", false) == true ||
        controlFinanceMap().get("anexar", false) == true
      );
    }

    function allowedContentType() {
      return request.resource != null &&
        request.resource.contentType is string &&
        (request.resource.contentType.matches("image/.*") ||
        request.resource.contentType in [
          "application/pdf",
          "application/msword",
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
          "application/vnd.ms-excel",
          "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
          "text/plain"
        ]);
    }

    function allowedUpload() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size < 10 * 1024 * 1024 &&
        allowedContentType();
    }

    // Documentos de clientes: acesso exclusivamente vinculado ao cliente, nunca ao tenant inteiro.
    function clientData(clienteId) {
      return firestore.get(/databases/(default)/documents/clientes_operacionais/$(clienteId)).data;
    }

    function clientExists(clienteId) {
      return firestore.exists(/databases/(default)/documents/clientes_operacionais/$(clienteId));
    }

    function clientDocumentReader(tenantId, clienteId) {
      return isSameTenant(tenantId) && clientExists(clienteId) &&
        clientData(clienteId).get("clientePlataformaId", "") == tenantId &&
        (isMasterLocal() ||
         userDoc().get("cargoChave", "") == "gerente" ||
         (userDoc().get("cargoChave", "") == "supervisor" &&
          clientData(clienteId).get("equipeId", "") == userDoc().get("equipeId", "")) ||
         ((userDoc().get("cargoChave", "") == "vendedor" ||
           userDoc().get("tipoUsuario", "") == "vendedor") &&
          (clientData(clienteId).get("vendedorAuthUid", "") == request.auth.uid ||
           clientData(clienteId).get("vendedorId", "") == request.auth.uid)));
    }

    match /tenants/{tenantId}/clientes-documentos/{clienteId}/{arquivo=**} {
      allow get: if clientDocumentReader(tenantId, clienteId);
      // Lista apenas a pasta do cliente autorizado. Nunca permite listar outros clientes.
      allow list: if clientDocumentReader(tenantId, clienteId);
      allow create: if clientDocumentReader(tenantId, clienteId) &&
        allowedUpload() &&
        request.resource.contentType in ["application/pdf", "image/jpeg", "image/png", "image/webp"] &&
        request.resource.size <= 8 * 1024 * 1024;
      allow update, delete: if false;
    }

    match /tenants/{tenantId}/{categoria}/{arquivo=**} {
      allow read: if categoria != "clientes-documentos" && (isMasterGlobal() ||
        (categoria == "financeiro" ? canReadEnterpriseFinance(tenantId) : isSameTenant(tenantId)));
      allow list: if false;
      allow create: if categoria != "clientes-documentos" && (
          isMasterGlobal() ||
          (categoria == "financeiro" ? canWriteEnterpriseFinance(tenantId) : isSameTenant(tenantId))
        ) &&
        (categoria != "chat" || !isAuditor()) &&
        (categoria != "chat" ? allowedUpload() : (
          request.resource != null &&
          request.resource.size > 0 && request.resource.size <= 8 * 1024 * 1024 &&
          request.resource.contentType.matches("image/.*")
        ));
      allow update: if false;
      allow delete: if categoria == "financeiro" && canWriteEnterpriseFinance(tenantId);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
