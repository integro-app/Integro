rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAuthenticated() {
      return request.auth != null;
    }

    function hasUserDoc() {
      return isAuthenticated() &&
        firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid));
    }

    function userDoc() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data;
    }

    function isActiveUser() {
      return hasUserDoc() &&
        userDoc().get("authUid", "") == request.auth.uid &&
        userDoc().get("acessoLiberado", false) == true &&
        !(userDoc().get("status", "") in ["BLOQUEADO", "INATIVO", "SUSPENSO"]);
    }

    function userTenantId() {
      return userDoc().get("clientePlataformaId", "");
    }

    function isMasterGlobal() {
      return hasUserDoc() && userDoc().get("tipoUsuario", "") == "master_global";
    }

    function isMasterLocal() {
      return hasUserDoc() && userDoc().get("tipoUsuario", "") == "master_local";
    }

    function isFinanceiro() {
      return hasUserDoc() && (userDoc().get("tipoUsuario", "") == "financeiro" ||
        userDoc().get("cargoChave", "") == "financeiro");
    }

    function isAuditor() {
      return hasUserDoc() && (userDoc().get("tipoUsuario", "") == "auditor" || userDoc().get("cargoChave", "") == "auditor");
    }

    function isSameTenant(tenantId) {
      return isActiveUser() &&
        userTenantId() is string &&
        userTenantId().size() > 0 &&
        userTenantId() == tenantId;
    }

    function controlFinanceMap() {
      return userDoc().get("permissoes", {}).get("controleFinanceiro", {});
    }

    function canReadEnterpriseFinance(tenantId) {
      return isSameTenant(tenantId) && !isMasterGlobal() && !isCommercialUser() && (
        isMasterLocal() || isFinanceiro() ||
        isFinancialSupervisor() || userDoc().get("responsavelFinanceiro", false) == true ||
        controlFinanceMap().get("ver", false) == true
      );
    }

    function isCommercialUser() {
      return userDoc().get("tipoUsuario", "") in ["vendedor", "captador"] ||
        userDoc().get("cargoChave", "") in ["vendedor", "captador"];
    }

    function isFinancialSupervisor() {
      return userDoc().get("tipoUsuario", "") == "supervisor_financeiro" ||
        userDoc().get("cargoChave", "") == "supervisor_financeiro" ||
        ((userDoc().get("tipoUsuario", "") == "supervisor" || userDoc().get("cargoChave", "") == "supervisor") &&
          userDoc().get("departamento", "") == "FINANCEIRO");
    }

    function canWriteEnterpriseFinance(tenantId) {
      return canReadEnterpriseFinance(tenantId) && !isAuditor() && (
        controlFinanceMap().get("editar", false) == true ||
        controlFinanceMap().get("anexar", false) == true
      );
    }

    function canDeleteEnterpriseFinance(tenantId) {
      return canReadEnterpriseFinance(tenantId) && !isAuditor() &&
        (isMasterLocal() || controlFinanceMap().get("editar", false) == true ||
          controlFinanceMap().get("anexar", false) == true);
    }

    function financialAccountExists(tenantId, contaId) {
      return firestore.exists(/databases/(default)/documents/financeiro_contas/$(contaId)) &&
        firestore.get(/databases/(default)/documents/financeiro_contas/$(contaId)).data.get("clientePlataformaId", "") == tenantId;
    }

    function financialRecordExists(tenantId, kind, id) {
      return (kind == "contas" && financialAccountExists(tenantId, id)) ||
        (kind == "pagamentos" && firestore.exists(/databases/(default)/documents/financeiro_pagamentos/$(id)) &&
          firestore.get(/databases/(default)/documents/financeiro_pagamentos/$(id)).data.get("clientePlataformaId", "") == tenantId &&
          financialAccountExists(tenantId, firestore.get(/databases/(default)/documents/financeiro_pagamentos/$(id)).data.get("contaId", "")));
    }

    function financialUploadMetadata(tenantId, kind, id) {
      return request.resource.metadata.get("tenantId", "") == tenantId &&
        request.resource.metadata.get("authUid", "") == request.auth.uid &&
        ((kind == "contas" && request.resource.metadata.get("contaId", "") == id) ||
          (kind == "pagamentos" && request.resource.metadata.get("pagamentoId", "") == id &&
            request.resource.metadata.get("contaId", "") == firestore.get(/databases/(default)/documents/financeiro_pagamentos/$(id)).data.get("contaId", "")));
    }

    function allowedContentType() {
      return request.resource != null &&
        request.resource.contentType is string &&
        (request.resource.contentType.matches("image/.*") ||
        request.resource.contentType in [
          "application/pdf",
          "application/msword",
          "application/vnd.openxmlformats-officedocument.wordprocessingml.document",
          "application/vnd.ms-excel",
          "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet",
          "text/plain"
        ]);
    }

    function allowedUpload() {
      return request.resource != null &&
        request.resource.size > 0 &&
        request.resource.size < 10 * 1024 * 1024 &&
        allowedContentType();
    }

    match /tenants/{tenantId}/{categoria}/{arquivo=**} {
      allow read: if categoria != "financeiro" && (isMasterGlobal() || isSameTenant(tenantId));
      allow list: if false;
      allow create: if categoria != "financeiro" && (isMasterGlobal() || isSameTenant(tenantId)) &&
        (categoria != "chat" || !isAuditor()) &&
        (categoria != "chat" ? allowedUpload() : (
          request.resource != null &&
          request.resource.size > 0 && request.resource.size <= 8 * 1024 * 1024 &&
          request.resource.contentType.matches("image/.*")
        ));
      allow update: if false;
      allow delete: if false;
    }

    match /tenants/{tenantId}/financeiro/{kind}/{id}/{filename} {
      allow get: if canReadEnterpriseFinance(tenantId) && financialRecordExists(tenantId, kind, id);
      allow list: if false;
      allow create: if resource == null && canWriteEnterpriseFinance(tenantId) && financialRecordExists(tenantId, kind, id) &&
        financialUploadMetadata(tenantId, kind, id) && allowedUpload();
      allow update: if false;
      allow delete: if canDeleteEnterpriseFinance(tenantId) && financialRecordExists(tenantId, kind, id);
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
